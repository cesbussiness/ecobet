# =====================================================================
# Variables de entorno (configurar en Netlify > Site settings > Env)
# NUNCA subir este archivo con valores reales al repositorio.
# =====================================================================

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxx...           # usado por el frontend (con RLS activo)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx...   # SOLO backend, bypassa RLS

# --- Autenticación propia ---
JWT_SECRET=cadena-larga-aleatoria-cambiar-ya

# --- SMTP Google (App Password de 16 dígitos, NO la clave de la cuenta) ---
GOOGLE_SMTP_USER=consultorio@gmail.com
GOOGLE_SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# --- CORS ---
FRONTEND_ORIGIN=https://tu-sitio.netlify.app
